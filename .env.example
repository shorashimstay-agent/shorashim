# Local settings for the developer tools. Copy this file to .env (git-ignored) and fill in the
# values for your machine. Never commit .env: it names local files and test accounts.
# Real environment variables override .env.

# Backend deploys (apps-script/deploy.py) and the staging suite (npm run test:e2e).
# Each booking config holds an environment's IDs and secrets; each token is an OAuth
# authorized-user file for the account that environment runs as.
SHORASHIM_PROD_CONFIG=/path/to/booking-config.json
SHORASHIM_PROD_TOKEN=/path/to/production-token.json
SHORASHIM_STAGING_CONFIG=/path/to/booking-config.staging.json
SHORASHIM_STAGING_TOKEN=/path/to/staging-token.json

# gcloud's configuration directory, for the gcloud commands in apps-script/README.md.
CLOUDSDK_CONFIG=/path/to/gcloud-config-dir

# Staging suite: the two test guests. TOKEN may be empty when the suite cannot read that
# guest's mail; CALENDAR is true when the token can also read the guest's calendar.
E2E_GUEST_A_EMAIL=guest-a@example.com
E2E_GUEST_A_TOKEN=/path/to/guest-a-token.json
E2E_GUEST_A_CALENDAR=true
E2E_GUEST_B_EMAIL=guest-a+guestb@example.com
E2E_GUEST_B_TOKEN=/path/to/guest-a-token.json
E2E_GUEST_B_CALENDAR=false

# Optional local tools. Empty means the bundled Chromium, and gitleaks on the PATH.
E2E_CHROME=
GITLEAKS=
