{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "images": "node scripts/optimize-images.mjs",
    "predev": "npm run images",
    "dev": "vite --port=3000 --host=0.0.0.0",
    "prebuild": "npm run images",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist src/assets/images/optimized src/data/generatedImages.ts public/og-image.jpg",
    "prelint": "npm run images",
    "lint": "tsc --noEmit",
    "test": "node --test shared/*.test.mjs",
    "test:e2e": "bash scripts/e2e.sh",
    "test:smoke": "E2E_TARGET=smoke playwright test --project=smoke",
    "test:a11y": "playwright test --project=staging a11y.spec.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
